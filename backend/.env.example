# Server
PORT=5002

# Database
# Supabase usually requires SSL. Use DB_SSL_MODE=disable only for local PostgreSQL.
DB_HOST=your-supabase-db-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_SSL_MODE=require

# Database connection pool
DB_POOL_MAX_SIZE=2
DB_POOL_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_MAX_LIFETIME_MS=300000

# Authentication
# Use a long random secret in real environments.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# Seeded admin account
# The backend creates or updates this admin user at startup when these values are set.
ADMIN_EMAIL=admin@hometutor.lk
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin User
